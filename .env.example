VBANK_ACCESS_TOKEN_TTL_MINUTES=15
VBANK_REFRESH_TOKEN_TTL_DAYS=30
VBANK_REFRESH_TOKEN_TRANSPORT=body
VBANK_REFRESH_TOKEN_COOKIE_NAME=vbank_refresh_token
VBANK_REFRESH_TOKEN_COOKIE_SECURE=false
VBANK_REFRESH_TOKEN_COOKIE_SAMESITE=lax
