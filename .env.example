VBANK_APP_NAME=VBank
VBANK_ENVIRONMENT=local
VBANK_DEBUG=true
VBANK_HOST=127.0.0.1
VBANK_PORT=8000
VBANK_DATABASE_URL=postgresql+psycopg://vbank_user:change_me@localhost:5432/vbank
VBANK_DATABASE_ECHO=false
VBANK_CORS_ORIGINS=["http://localhost:5173"]
VBANK_ACCESS_TOKEN_SECRET=change_me_for_local_development_secret
